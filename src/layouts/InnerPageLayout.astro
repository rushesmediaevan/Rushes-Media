---
import type { InnerPage } from '../data/inner-pages';
import DemandLoopLayout from './DemandLoopLayout.astro';
import ServicePageLayout from './ServicePageLayout.astro';

interface Props { page: InnerPage; }
const { page } = Astro.props;
---

{page.family === 'mechanism'
  ? <DemandLoopLayout page={page} />
  : <ServicePageLayout page={page} />}
