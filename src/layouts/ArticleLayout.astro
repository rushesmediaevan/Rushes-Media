---
import BaseLayout from './BaseLayout.astro';
import { SITE, HOME_FONT_URL } from '../data/site';
import { ARTICLES } from '../../scripts/article-routes.mjs';
import '../styles/articles.css';

interface Props { frontmatter?: { slug: string }; }
const article = ARTICLES.find((item) => item.slug === Astro.props.frontmatter?.slug);
if (!article) throw new Error('Article must be registered in scripts/article-routes.mjs');
const canonical = `${SITE.origin}/articles/${article.slug}/`;
const updatedLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${article.lastmod}T00:00:00Z`));
const seo = {
  title: `${article.title} — Rushes Media`,
  description: article.description,
  canonical,
  openGraph: { type: 'article', title: article.title, description: article.description, url: canonical, siteName: 'Rushes Media' },
  twitter: { card: 'summary', title: article.title, description: article.description },
  jsonLd: {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: article.title, description: article.description, mainEntityOfPage: canonical,
    dateModified: article.lastmod,
    author: { '@type': 'Organization', name: 'Rushes Media', url: SITE.origin },
    publisher: { '@type': 'Organization', name: 'Rushes Media', url: SITE.origin },
  },
};
---
<BaseLayout seo={seo} fontUrl={HOME_FONT_URL}>
  <header class="article-nav">
    <a href="/" class="article-brand" aria-label="Rushes Media — home">Rushes Media</a>
    <a href="/articles/">All articles</a>
  </header>
  <main id="main-content" class="article-shell" tabindex="-1">
    <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/articles/">Articles</a> / {article.category}</nav>
    <article>
      <header><p class="article-eyebrow">{article.category} · By Rushes Media</p><h1>{article.title}</h1><p class="article-deck">{article.description}</p><p class="article-updated">Updated <time datetime={article.lastmod}>{updatedLabel}</time></p></header>
      <div class="article-prose"><slot /></div>
    </article>
    <aside class="article-next" aria-label="Next step">
      <h2>Bring the project you’re considering.</h2>
      <p>Discuss what your business needs, the work you already have and the next step you want customers to take.</p>
      <a href="/#book">Book a Growth Call →</a>
    </aside>
  </main>
  <footer class="article-footer"><a href="/articles/">Articles</a><a href="/campaigns/">Campaigns</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><p>© {new Date().getFullYear()} {SITE.legalName}</p></footer>
<script is:inline>
  (() => {
    const host = location.hostname.toLowerCase();
    if (['localhost', '127.0.0.1', '[::1]'].includes(host) || host.endsWith('.test')) return;
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
      if (!link || typeof window.gtag !== 'function') return;
      const target = new URL(link.href, location.href);
      if (target.origin !== location.origin) return;
      const service = ['/brand-media/', '/campaigns/', '/web/', '/follow-up/', '/demand-loop/'].includes(target.pathname);
      if (!service) return;
      window.gtag('event', 'article_service_click', {
        page_path: location.pathname,
        article_slug: location.pathname.split('/').filter(Boolean).pop(),
        link_location: link.closest('.article-next') ? 'article-next-step' : 'article-content',
        destination_path: target.pathname + target.hash,
      });
    });
  })();
</script>
</BaseLayout>
