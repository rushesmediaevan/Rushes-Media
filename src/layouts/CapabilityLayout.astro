---
import ConceptPicture from '../components/brand-media/ConceptPicture.astro';
import BookingWidget from '../components/shared/BookingWidget.astro';
import EditorialFooter from '../components/shared/EditorialFooter.astro';
import EditorialHeader from '../components/shared/EditorialHeader.astro';
import type { CapabilityPage } from '../data/capability-pages';
import { innerPageNavigation } from '../data/inner-pages';
import { HOME_FONT_URL, SITE } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface Props { page: CapabilityPage; }
const { page } = Astro.props;
const canonical = `${SITE.origin}/${page.slug}/`;
const seo = {
  title: page.title,
  description: page.description,
  canonical,
  openGraph: { title: page.title, description: page.description, url: canonical },
};
---

<BaseLayout seo={seo} fontUrl={HOME_FONT_URL} includeMetaPixel>
  <link slot="head" rel="stylesheet" href="/assets/inner-page.css" />
  <link slot="head" rel="stylesheet" href="/assets/brand-media.css" />

  <EditorialHeader current={page.current} />
  <main
    id="main-content"
    tabindex="-1"
    class="brand-media-page capability-page"
    data-page-family={page.family}
    data-brand-media-page={page.family === 'brand-media' ? true : undefined}
    data-service={page.slug}
  >
    <header class="brand-media-hero capability-hero">
      <div class="brand-media-hero__copy">
        <p class="brand-media-breadcrumb">
          {page.breadcrumb.map((item, index) => (
            <>
              {index === 0 ? <a href="/">{item}</a> : index === page.breadcrumb.length - 1 ? <b>{item}</b> : <span>{item}</span>}
              {index < page.breadcrumb.length - 1 && <span>/</span>}
            </>
          ))}
        </p>
        <span class="brand-media-eye">{page.eyebrow}</span>
        <h1>{page.hero.heading}</h1>
        <p class="brand-media-hero__support">{page.hero.support}</p>
        <div class="brand-media-actions">
          <a class="brand-media-text-link" href={page.hero.secondaryTarget}>
            {page.hero.secondaryLabel}<span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div class="brand-media-hero__visuals">
        <ConceptPicture
          asset={page.hero.visual}
          className="brand-media-hero__main"
          sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) 48vw, 660px"
          loading="eager"
          fetchpriority="high"
          showCaption={false}
        />
        <ConceptPicture
          asset={page.hero.insetVisual}
          className="brand-media-hero__inset"
          sizes="(max-width: 760px) 40vw, 238px"
          showCaption={false}
        />
      </div>
    </header>

    {page.loopSteps && (
      <section id="loop-stages" tabindex="-1" class="capability-loop" aria-labelledby="loop-stages-heading">
        <div class="brand-media-section-lead brand-media-section-lead--light">
          <span class="brand-media-eye">Five connected moments</span>
          <h2 id="loop-stages-heading">From attention to action, without the usual gaps.</h2>
        </div>
        <ol class="capability-loop-list">
          {page.loopSteps.map((step, index) => (
            <li>
              <header id={`loop-stage-${index + 1}`} tabindex="-1">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <small>{step.stage}</small>
                <h3>{step.name}</h3>
                <p>{step.purpose}</p>
                <b>{step.capability}</b>
              </header>
            </li>
          ))}
        </ol>
      </section>
    )}

    <div class="capability-answers">
      {page.answers.map((answer) => (
        <article id={answer.id} tabindex="-1">
          <span class="brand-media-eye">{answer.eye}</span>
          <h2>{answer.heading}</h2>
          <p>{answer.body}</p>
        </article>
      ))}
    </div>

    <section class="brand-media-faq capability-faq" aria-labelledby="capability-faq-heading">
      <div>
        <span class="brand-media-eye">{page.faq.eyebrow}</span>
        <h2 id="capability-faq-heading">{page.faq.heading}</h2>
      </div>
      <div class="brand-media-faq__list">
        {page.faq.items.map((item) => (
          <details>
            <summary>{item.question}<span aria-hidden="true">+</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="book" tabindex="-1" class="brand-media-booking" aria-labelledby="capability-booking-heading">
      <div class="brand-media-booking__copy">
        <span class="brand-media-eye">{page.booking.eyebrow}</span>
        <h2 id="capability-booking-heading">{page.booking.heading}</h2>
        <p>{page.booking.body}</p>
        <span class="brand-media-booking__note">{page.booking.note}</span>
      </div>
      <BookingWidget route={`/${page.slug}/`} variant="editorial" frameId={`rushes-${page.slug}-growth-call-calendar`} />
    </section>

    <p class="capability-disclosure">Some scenes are Rushes concept imagery, not client work.</p>

    <nav class="commercial-route-links" aria-label="Related Rushes Media routes">
      {innerPageNavigation.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
    </nav>
  </main>
  <EditorialFooter />
</BaseLayout>
