---
import BookingWidget from '../components/shared/BookingWidget.astro';
import EditorialFooter from '../components/shared/EditorialFooter.astro';
import EditorialHeader from '../components/shared/EditorialHeader.astro';
import type { ServicePage } from '../data/inner-pages';
import { innerPageNavigation, innerPageSeo } from '../data/inner-pages';
import { HOME_FONT_URL, SHARED_CTA } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface Props { page: ServicePage; }
const { page } = Astro.props;
const seo = innerPageSeo(page);
---

<BaseLayout seo={seo} fontUrl={HOME_FONT_URL} includeMetaPixel>
  <link slot="head" rel="stylesheet" href="/assets/inner-page.css" />

  <EditorialHeader current="services" />
  <main class="commercial-page" data-page-family={page.family} data-service={page.slug} data-signature={page.signature.kind}>
    <header class="service-hero">
      <div class="service-hero-copy">
        <p class="commercial-breadcrumb"><a href="/">Home</a><span>/</span><span>Services</span><span>/</span><b>{page.eyebrow}</b></p>
        <span class="commercial-eye">{page.eyebrow}</span>
        <h1>{page.heading.map((segment) => segment.kind === 'emphasis' ? <em>{segment.text}</em> : segment.text)}</h1>
        <p class="service-lede">{page.lede}</p>
        <div class="service-actions">
          <a class="commercial-button commercial-button-primary" href="#book" data-growth-call-click data-link-location="hero">{SHARED_CTA.label} <span aria-hidden="true">→</span></a>
          <a class="commercial-button" href="#service-system">See how this service works</a>
        </div>
      </div>
      <aside class="service-question" aria-label="Commercial question">
        <span>Commercial question</span>
        <p>{page.commercialQuestion}</p>
        <dl>
          <div><dt>Not measured by</dt><dd>activity alone</dd></div>
          <div><dt>Measured through</dt><dd>the next real handoff</dd></div>
        </dl>
      </aside>
    </header>

    <section class="commercial-section service-problem" aria-labelledby="service-problem-heading">
      <div class="commercial-section-head">
        <span class="commercial-eye">Where value leaks</span>
        <h2 id="service-problem-heading">{page.problemHeading}</h2>
        <p>{page.problemIntro}</p>
      </div>
      <div class="service-pain-grid">
        {page.pains.map((pain, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{pain.title}</h3>
            <p>{pain.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="service-system" class="commercial-section service-signature" aria-labelledby="signature-heading">
      <div class="commercial-section-head commercial-section-head-split">
        <div>
          <span class="commercial-eye">{page.signature.eyebrow}</span>
          <h2 id="signature-heading">{page.signature.heading}</h2>
        </div>
        <p>{page.signature.intro}</p>
      </div>
      <div class="service-signature-grid">
        {page.signature.items.map((item) => (
          <article class="service-signature-item">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.note && <small>{item.note}</small>}
          </article>
        ))}
      </div>
    </section>

    <section class="commercial-section service-process" aria-labelledby="service-process-heading">
      <div class="commercial-section-head">
        <span class="commercial-eye">Operating sequence</span>
        <h2 id="service-process-heading">{page.processHeading}</h2>
        <p>{page.processIntro}</p>
      </div>
      <ol class="service-process-list">
        {page.process.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="commercial-section service-ownership" aria-labelledby="ownership-heading">
      <div class="commercial-section-head">
        <span class="commercial-eye">Responsibilities and evidence</span>
        <h2 id="ownership-heading">The handoff is part of the deliverable.</h2>
      </div>
      <div class="ownership-grid">
        <article>
          <span>Owner responsibilities</span>
          <ul>{page.ownerResponsibilities.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <span>Rushes responsibilities</span>
          <ul>{page.rushesResponsibilities.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article class="ownership-deliverables">
          <span>Working outputs</span>
          <ol>{page.deliverables.map((item, index) => <li><b>{String(index + 1).padStart(2, '0')}</b>{item}</li>)}</ol>
        </article>
        <aside class="proof-boundary">
          <span>Proof boundary</span>
          <p>{page.proofBoundary}</p>
        </aside>
      </div>
    </section>

    <section class="commercial-section service-fit" aria-labelledby="service-fit-heading">
      <div class="commercial-section-head">
        <span class="commercial-eye">Qualification</span>
        <h2 id="service-fit-heading">Fit before scope.</h2>
      </div>
      <div class="commercial-fit-grid">
        <article><span>Good fit</span><ul>{page.goodFit.map((item) => <li>{item}</li>)}</ul></article>
        <article><span>Poor fit</span><ul>{page.poorFit.map((item) => <li>{item}</li>)}</ul></article>
      </div>
    </section>

    <section class="commercial-section service-faq" aria-labelledby="service-faq-heading">
      <div class="commercial-section-head">
        <span class="commercial-eye">Questions before the call</span>
        <h2 id="service-faq-heading">What this page does—and does not—promise.</h2>
      </div>
      <div class="commercial-faq-list">
        {page.faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
      </div>
    </section>

    <section id="book" tabindex="-1" class="commercial-booking" aria-labelledby="service-booking-heading">
      <div class="commercial-booking-copy">
        <span class="commercial-eye">Growth Call</span>
        <h2 id="service-booking-heading">Inspect the whole path before buying one piece.</h2>
        <p>Thirty minutes to look at the work, buyer, handoffs, response reality and clearest next action. No generic deck and no obligation.</p>
        <ul><li>The work and buyer you actually want</li><li>The handoff currently losing value</li><li>One bounded next step—or an honest no</li></ul>
      </div>
      <BookingWidget route={`/${page.slug}/`} variant="editorial" frameId={`rushes-${page.slug}-growth-call-calendar`} />
    </section>

    <nav class="commercial-route-links" aria-label="Related Rushes Media routes">
      {innerPageNavigation.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
    </nav>
  </main>
  <EditorialFooter />
</BaseLayout>
