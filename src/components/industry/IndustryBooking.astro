---
import { SHARED_CTA, SITE } from '../../data/site';

interface Props {
  route: string;
  intro?: string;
}

const {
  route,
  intro = '30 minutes. We’ll inspect the work you want, the path into the calendar, and whether the economics and capacity fit.',
} = Astro.props;
---

<section id="book" class="industry-booking" data-booking-section data-industry-route={route}>
  <div class="industry-booking-copy">
    <span class="industry-eye">Growth Call</span>
    <h2>See whether the full path fits.</h2>
    <p>{intro}</p>
    <ul aria-label="What the call covers">
      <li>The work and buyer you actually want</li>
      <li>Where the current handoffs deserve inspection</li>
      <li>The clearest next step—or an honest no</li>
    </ul>
  </div>
  <div class="industry-calendar-shell">
    <div class="industry-calendar-heading">
      <span>{SHARED_CTA.label}</span>
      <small>Name, phone and SMS preferences are inside the calendar.</small>
    </div>
    <iframe
      src={SITE.bookingUrl}
      title={SHARED_CTA.iframeTitle}
      id="rushes-industry-growth-call-calendar"
      data-industry-booking-frame
      allow="clipboard-write"
      loading="lazy"
      width="1280"
      height="720"
    ></iframe>
  </div>
</section>

<script is:inline>
  (() => {
    const localHosts = ['localhost', '127.0.0.1', '[::1]'];
    const host = location.hostname.toLowerCase();
    const suppressAnalytics = localHosts.includes(host) || host.endsWith('.test');
    const section = document.querySelector('[data-booking-section]');
    const frame = section?.querySelector('[data-industry-booking-frame]');
    const route = section?.getAttribute('data-industry-route') || location.pathname;
    const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

    if (frame) {
      const destination = new URL(frame.getAttribute('src'), location.href);
      const current = new URL(location.href);
      for (const key of keys) {
        const value = current.searchParams.get(key);
        if (value) destination.searchParams.set(key, value.slice(0,120));
      }
      frame.setAttribute('src', destination.toString());
    }

    const emit = (name, parameters) => {
      if (suppressAnalytics || typeof window.gtag !== 'function') return;
      window.gtag('event', name, { industry_route: route, ...parameters });
    };

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('[data-growth-call-click]')
        : null;
      if (!link) return;
      emit('growth_call_click', {
        link_location: link.getAttribute('data-link-location') || 'unknown',
      });
    });

    if (section && 'IntersectionObserver' in window) {
      let sent = false;
      const observer = new IntersectionObserver((entries) => {
        if (sent || !entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.5)) return;
        sent = true;
        emit('booking_section_view', { visibility_threshold: 50 });
        observer.disconnect();
      }, { threshold: [0.5] });
      observer.observe(section);
    }
  })();
</script>
