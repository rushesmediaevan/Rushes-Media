---
interface Props {
  current: string;
  includeIndustries?: boolean;
}

const { current, includeIndustries = true } = Astro.props;
---

<nav class="industry-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {includeIndustries && <li><a href="/industries/">Industries</a></li>}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
