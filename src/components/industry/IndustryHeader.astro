---
import { SHARED_CTA, SITE } from '../../data/site';
import MobileNavDialog from '../shared/MobileNavDialog.astro';

interface Props { current?: 'page' | 'location'; }
const { current } = Astro.props;
const mobileLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/industries/', label: 'Industries', current },
  { href: '/demand-loop/', label: 'Demand Loop' },
  { href: '#book', label: SHARED_CTA.label, cta: true },
] as const;
---

<nav class="industry-nav" aria-label="Primary navigation">
  <a href="/" class="industry-logo" aria-label="Rushes Media — home">
    <img src={SITE.logoIcon} alt="" width="833" height="959" />
    <img src={SITE.logoWordmark} alt="Rushes Media" width="2888" height="322" />
  </a>
  <div class="industry-nav-links">
    <a href="/industries/" aria-current={current}>Industries</a>
    <a href="/demand-loop/">Demand Loop</a>
    <a href="#book" class="industry-nav-cta" data-growth-call-click data-link-location="navigation">
      {SHARED_CTA.label}
    </a>
  </div>
  <MobileNavDialog id="industry-mobile-navigation" links={mobileLinks} />
</nav>
