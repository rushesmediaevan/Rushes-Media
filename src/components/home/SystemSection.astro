---
import { systemSteps } from '../../data/home';
---

<!-- ══ SYSTEM ═════════════════════════════════════════════ -->
<section id="system" tabindex="-1">
  <div class="system-inner">
    <div class="system-hd r">
      <span class="eye">The Demand Loop</span>
      <h2 class="system-h2">Build more demand. Make the business easier to run.</h2>
      <p class="system-sub">The Demand Loop connects the work around growth. Brand Media earns attention. Creative Campaigns extend the reach. Web helps the right buyer understand and act. AI, business systems, and follow-up reduce friction, speed up response, and keep opportunities moving.</p>
    </div>
    <ol class="system-flow r d1" aria-label="The Demand Loop: five moments from visibility to qualified opportunity">
      {systemSteps.map((step, index) => (
        <li class="sys-step">
          <span class="sys-node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="sys-stage">{step.stage}</div>
          <h3 class="sys-step-name">{step.title}</h3>
          <p class="sys-step-service">
            <span>Rushes capability</span>
            <strong>{step.owner}</strong>
          </p>
          <p class="sys-step-desc">{step.description}</p>
          {index < systemSteps.length - 1 && <span class="sys-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
    <div class="system-end">
      <p class="system-close">Use one capability or connect the full path. The goal is more visibility, more qualified opportunities, a clearer path to revenue, and less time lost to disconnected work.</p>
      <a class="system-link" href="/demand-loop/">Explore the complete Demand Loop <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
