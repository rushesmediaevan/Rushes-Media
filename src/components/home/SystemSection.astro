---
import { systemSteps } from '../../data/home';
---

<!-- ══ SYSTEM ═════════════════════════════════════════════ -->
<section id="system" tabindex="-1">
  <div class="system-inner">
    <div class="system-hd r">
      <span class="eye">How It Connects</span>
      <h2 class="system-h2">Make a strong business easier to see—and easier to choose.</h2>
      <p class="system-sub">Brand Media earns attention by making the value visible. Creative Campaigns carry the strongest idea to more of the right people. Web makes the offer easier to understand and act on. When inquiry or booking is part of the work, Lead Capture and Follow-up protect genuine interest through the next conversation.</p>
    </div>
    <ol class="system-flow r d1" aria-label="Five moments from visibility to qualified opportunity">
      {systemSteps.map((step, index) => (
        <li class="sys-step">
          <span class="sys-node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="sys-stage">{step.stage}</div>
          <h3 class="sys-step-name">{step.title}</h3>
          <p class="sys-step-service">
            <span>Rushes capability</span>
            <strong>{step.owner}</strong>
          </p>
          <p class="sys-step-desc">{step.description}</p>
          {index < systemSteps.length - 1 && <span class="sys-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
    <p class="system-close">Start with the business priority. Connect only what strengthens the path from visibility to qualified opportunity—and, ultimately, customers and revenue.</p>
  </div>
</section>
