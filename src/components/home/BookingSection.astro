---
import { SHARED_CTA, SITE } from '../../data/site';
---

<!-- ══ CTA ════════════════════════════════════════════════ -->
<section id="cta">
  <div class="cta-inner">
    <span class="eye r" style="color:var(--gold)">Ready when you are</span>
    <h2 class="cta-h2 r d1">Let's build something<br /><em>that books work.</em></h2>
    <p class="cta-sub r d2">Book a Growth Call. We’ll look at your market and show you how we’d grow it — straight answer if it’s a fit.</p>
    <p class="cta-pledge r d2">We prove booked estimates before you’re locked into month two.<br /><em>You close the jobs. We own the path from attention to the calendar.</em></p>

    <div class="cta-book r d3">
      <span id="book" class="booking-anchor" aria-hidden="true"></span>
      <span class="eye" style="color:var(--gold)">Growth Call</span>
      <h3 class="cta-book-h3">{SHARED_CTA.label}</h3>
      <p class="cta-book-sub">Pick a time — name, phone, and SMS preferences are on the final step inside the calendar.</p>
      <div class="cta-cal-wrap">
        <iframe
          src={SITE.bookingUrl}
          title={SHARED_CTA.iframeTitle}
          id="rushes-growth-call-calendar"
          class="ghl-booking-embed"
          allow="clipboard-write"
          loading="lazy"
          width="1280"
          height="720"
        ></iframe>
      </div>
    </div>
  </div>
</section>
