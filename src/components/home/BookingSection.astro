---
import { SHARED_CTA } from '../../data/site';
import BookingWidget from '../shared/BookingWidget.astro';
---

<!-- ══ CTA ════════════════════════════════════════════════ -->
<section id="cta">
  <div class="cta-inner">
    <span class="eye eye-on-light r">30-minute Growth Call</span>
    <h2 class="cta-h2 r d1">Find the clearest way to strengthen how the business is seen and chosen.</h2>
    <p class="cta-sub r d2">In 30 minutes, we’ll look at what already works, the priority that matters now, and the creative or digital move most likely to strengthen it.</p>

    <section id="book" tabindex="-1" class="cta-book" aria-labelledby="home-booking-heading">
      <span class="eye eye-on-light">Growth Call</span>
      <h3 id="home-booking-heading" class="cta-book-h3">{SHARED_CTA.label}</h3>
      <p class="cta-book-sub">Choose a time that works for you.</p>
      <div class="cta-cal-wrap">
        <BookingWidget route="/" variant="home" frameId="rushes-growth-call-calendar" />
      </div>
    </section>
  </div>
</section>
