---
import { proofItems } from '../../data/home';
---

<!-- ══ PROOF ══════════════════════════════════════════════ -->
<section id="proof">
  <div class="proof-layout">
    <div class="proof-head r">
      <span class="eye">What gets measured</span>
      <h2>Measure the business priority—not activity for its own sake.</h2>
      <p>Rushes defines the useful signals for the agreed scope—attention for media, qualified demand for campaigns, decision and action for web, or response and held appointments when follow-up is part of the work. The business owns sales and revenue outcomes.</p>
    </div>
    <ul class="proof-inner r d1">
      {proofItems.map((item, index) => (
        <li class:list={['proof-cell', 'r', index > 0 && `d${index}`]}>
          <span class="proof-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="proof-lbl">{item.label}</div>
          <div class="proof-txt">{item.text}</div>
        </li>
      ))}
    </ul>
  </div>
</section>
