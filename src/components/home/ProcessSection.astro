---
import { processSteps } from '../../data/home';
---

<!-- ══ PROCESS ════════════════════════════════════════════ -->
<section id="process" tabindex="-1">
  <div class="process-inner">
    <div class="process-hd r">
      <span class="eye">How We Start</span>
      <h2 class="process-h2">Start with the opportunity the business wants to grow.</h2>
      <p>Rushes identifies the clearest opportunity to improve growth or save time, then recommends the media, campaign, web, AI, or business-system work that can help.</p>
    </div>
    <ol class="steps process-sequence">
      {processSteps.map((step, index) => (
        <li class:list={['r', `d${index + 1}`]}>
          <div class="step-phase">{step.phase}</div>
          <div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
          <span class="step-badge">{step.badge}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
