---
import { homeServices } from '../../data/home';
---

<!-- ══ SERVICES ═══════════════════════════════════════════ -->
<section id="services">
  <div class="svc-hd">
    <h2 class="svc-h2 r">What We Build</h2>
    <span class="svc-count r d1">04 Services</span>
  </div>
  <div class="svc-list">
    {homeServices.map((service, index) => (
      <a class:list={['svc-row', 'r', index > 0 && `d${index}`]} href={service.href}>
        <span class="svc-n">{service.number}</span>
        <div>
          <h3 class="svc-name">{service.name}</h3>
          <span class="svc-name-plain">{service.plainName}</span>
        </div>
        <div class="svc-body">
          <p class="svc-desc">{service.description}</p>
          <div class="svc-tags">
            {service.tags.map((tag) => <span class="svc-tag">{tag}</span>)}
          </div>
        </div>
        <span class="svc-arr" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
