---
import { brandMediaFilm, homeServices, systemsBeats } from '../../data/home';
import { homepageAssets } from '../../data/homepage-assets';
import HomePicture from './HomePicture.astro';

const brand = homeServices[0];
const campaigns = homeServices[1];
const web = homeServices[2];
const systems = homeServices[3];
---

<section id="services" class="v3-services" tabindex="-1" aria-labelledby="v3-services-heading">
  <header class="v3-services-head">
    <div>
      <span class="eye">What Rushes does</span>
      <h2 id="v3-services-heading" class="svc-h2">Capabilities that move the business forward.</h2>
    </div>
    <p>
      Rushes brings together brand media, creative campaigns, websites and business systems.
      Hire one on its own, or connect them through the Demand Loop.
    </p>
  </header>

  <article class="v3-chapter" aria-labelledby="v3-brand-heading">
    <figure class="v3-film" aria-label="Brand Media photographic sequence">
      <div class="v3-film-hero">
        <HomePicture asset={brandMediaFilm[0]} sizes="(max-width: 760px) 100vw, 42vw" />
      </div>
      <div>
        <HomePicture asset={brandMediaFilm[1]} sizes="(max-width: 760px) 50vw, 18vw" />
      </div>
      <div>
        <HomePicture asset={brandMediaFilm[2]} sizes="(max-width: 760px) 50vw, 18vw" />
      </div>
    </figure>
    <div class="v3-chapter-copy">
      <span class="v3-kicker">{brand.stage}</span>
      <h3 id="v3-brand-heading">{brand.name}</h3>
      <p class="v3-claim">{brand.plainName}</p>
      <p>{brand.description}</p>
      <ul class="v3-tags" aria-label="Includes">{brand.tags.map((tag) => <li>{tag}</li>)}</ul>
      <a class="v3-more" href={brand.href}>Open Brand Media<span aria-hidden="true">→</span></a>
    </div>
  </article>

  <article class="v3-chapter" aria-labelledby="v3-campaigns-heading">
    <figure class="v3-web-photo v3-campaign-photo" aria-label="Creative Campaigns photograph">
      <HomePicture asset={homepageAssets.campaignsSubmerged} sizes="(max-width: 760px) 100vw, 48vw" />
    </figure>
    <div class="v3-chapter-copy">
      <span class="v3-kicker">{campaigns.stage}</span>
      <h3 id="v3-campaigns-heading">{campaigns.name}</h3>
      <p class="v3-claim">{campaigns.plainName}</p>
      <p>{campaigns.description}</p>
      <ul class="v3-tags" aria-label="Includes">{campaigns.tags.map((tag) => <li>{tag}</li>)}</ul>
      <a class="v3-more" href={campaigns.href}>Open Creative Campaigns<span aria-hidden="true">→</span></a>
    </div>
  </article>

  <article class="v3-chapter" aria-labelledby="v3-web-heading">
    <figure class="v3-web-photo" data-slot="web-proof" aria-label="Web and digital experience photograph">
      <HomePicture asset={web.visual!} sizes="(max-width: 760px) 100vw, 48vw" />
    </figure>
    <div class="v3-chapter-copy">
      <span class="v3-kicker">{web.stage}</span>
      <h3 id="v3-web-heading">{web.name}</h3>
      <p class="v3-claim">{web.plainName}</p>
      <p>{web.description}</p>
      <ul class="v3-tags" aria-label="Includes">{web.tags.map((tag) => <li>{tag}</li>)}</ul>
      <a class="v3-more" href={web.href}>Open Web & Landing<span aria-hidden="true">→</span></a>
    </div>
  </article>

  <article class="v3-chapter v3-chapter--systems" aria-labelledby="v3-systems-heading">
    <div class="v3-systems" aria-label="Four things a connected system handles">
      <svg class="v3-systems-map" viewBox="0 0 640 132" aria-hidden="true" focusable="false">
        <path class="v3-systems-line" d="M88 40 H192 M228 40 H332 M368 40 H472" />
        {systemsBeats.map((beat, index) => (
          <>
            <circle cx={70 + index * 140} cy="40" r="18" />
            <text x={70 + index * 140} y="45" text-anchor="middle">{String(index + 1).padStart(2, '0')}</text>
            <text class="v3-systems-label" x={70 + index * 140} y="86" text-anchor="middle">{beat.label}</text>
          </>
        ))}
      </svg>
      <ol>
        {systemsBeats.map((beat, index) => (
          <li>
            <span><b>{String(index + 1).padStart(2, '0')}</b> {beat.label}</span>
            <strong>{beat.heading}</strong>
            <p>{beat.example}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="v3-chapter-copy">
      <span class="v3-kicker">{systems.stage}</span>
      <h3 id="v3-systems-heading">{systems.name}</h3>
      <p class="v3-claim">{systems.plainName}</p>
      <p>{systems.description}</p>
      <ul class="v3-tags" aria-label="Includes">{systems.tags.map((tag) => <li>{tag}</li>)}</ul>
      <a class="v3-more" href={systems.href}>Open AI &amp; Business Systems<span aria-hidden="true">→</span></a>
    </div>
  </article>
</section>
