---
import { primaryNavigation } from '../../data/home';
import { SHARED_CTA, SITE } from '../../data/site';
import { Image } from 'astro:assets';
import logoIcon from '../../../assets/images/logo-icon.png';
import logoWordmark from '../../../assets/images/logo-wordmark.png';
---

<dialog id="mob" aria-label="Navigation menu">
  <button id="mob-x" aria-label="Close menu">✕</button>
  <div class="mob-inner">
    <span class="mob-eye">Menu</span>
    <ul class="mob-list">
      {primaryNavigation.map((item) => (
        <li>
          <span class="mob-n">{item.number}</span>
          <a href={item.href}>
            {item.label}
            <span class="mob-sub">{item.mobileSubtitle}</span>
          </a>
          <span class="mob-arr" aria-hidden="true">→</span>
        </li>
      ))}
    </ul>
    <div class="mob-foot">
      <a class="mob-cta" href={SHARED_CTA.href}>
        {SHARED_CTA.label} <span aria-hidden="true">→</span>
      </a>
      <p class="mob-foot-meta">
        <em>{SITE.name}</em><br />
        Media that converts.
      </p>
    </div>
  </div>
</dialog>

<nav id="nav">
  <a href="/" class="logo" aria-label="Rushes Media — home">
    <Image src={logoIcon} alt="" class="logo-crest" height={48} densities={[1, 2, 3]} format="webp" quality="max" loading="eager" />
    <Image src={logoWordmark} alt="Rushes Media" class="logo-wordmark" height={22} densities={[1, 2, 3]} format="webp" quality="max" loading="eager" />
  </a>
  <ul class="nav-r">
    {primaryNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    <li><a href={SHARED_CTA.href} class="cta">{SHARED_CTA.label}</a></li>
  </ul>
  <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="mob"><span></span><span></span><span></span></button>
  <noscript>
    <ul class="home-noscript-nav" aria-label="Mobile navigation">
      {primaryNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={SHARED_CTA.href}>{SHARED_CTA.label}</a></li>
    </ul>
  </noscript>
</nav>
