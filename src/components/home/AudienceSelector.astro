---
import { audiences } from '../../data/home';
import HomePicture from './HomePicture.astro';
---

<section id="examples" tabindex="-1" aria-labelledby="examples-heading">
  <div class="v3-examples-head">
    <span>Creative directions · concept imagery</span>
    <h2 id="examples-heading">Different businesses. Different opportunities.</h2>
    <div>
      <p>A few visual directions for businesses we can support. These are concepts, not completed client projects.</p>
    </div>
  </div>
  <div class="v3-range">
    {audiences.map((audience) => (
      <article
        class="v3-range-card"
        data-visual-truth={audience.visual.truthClass}
      >
        <figure>
          <HomePicture
            asset={audience.visual}
            sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1440px) 44vw, 624px"
          />
        </figure>
        <span class="who-card-route">{audience.routeLabel}</span>
        <h3>{audience.label}</h3>
        <p>{audience.summary}</p>
      </article>
    ))}
  </div>
</section>
