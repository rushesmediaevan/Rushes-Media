---
import { audiences } from '../../data/home';

---

<section id="who" aria-labelledby="who-heading">
  <div class="who-head">
    <span>Industry examples</span>
    <h2 id="who-heading">Different businesses. Different ways to grow.</h2>
    <div>
      <p>Rushes works across industries. These examples show how the approach changes with different customers, decisions, and business goals. The right mix might include stronger media, wider reach, a better digital experience, practical AI, or systems that save the team time.</p>
      <a href="/industries/">Explore the industry examples <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="who-market-grid">
    {audiences.map((audience, index) => (
      <a class:list={['who-card', `who-card--${index + 1}`]} href={audience.href} data-visual-truth={audience.visual.truthClass}>
        <figure>
          <picture>
            {audience.visual.sources.map((source) => (
              <source srcset={source.srcset} sizes={audience.visual.sizes} type={source.type} media={source.media} />
            ))}
            <img
              src={audience.visual.fallback.src}
              srcset={audience.visual.fallback.srcset}
              sizes={audience.visual.sizes}
              width={audience.visual.fallback.width}
              height={audience.visual.fallback.height}
              alt={audience.visual.alt}
              loading="lazy"
              decoding="async"
              style={`--who-focal:${audience.visual.focalPoint};--who-mobile-focal:${audience.visual.mobileFocalPoint ?? audience.visual.focalPoint}`}
            />
          </picture>
        </figure>
        <div class="who-card-copy">
          <span class="who-card-route">{audience.routeLabel}</span>
          <h3>{audience.label}</h3>
          <p>{audience.summary}</p>
          <div class="who-card-result"><span>Built to improve</span><b>{audience.result}</b></div>
          <strong>Explore this market <span aria-hidden="true">→</span></strong>
        </div>
      </a>
    ))}
  </div>
</section>
