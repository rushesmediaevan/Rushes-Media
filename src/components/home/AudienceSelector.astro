---
import { audiences } from '../../data/home';
import HomePicture from './HomePicture.astro';
---

<section id="examples" tabindex="-1" aria-labelledby="examples-heading">
  <div class="v3-examples-head">
    <span>Selected applications</span>
    <h2 id="examples-heading">Different businesses. Different opportunities.</h2>
    <div>
      <p>Rushes works across industries. The right work depends on what the business is trying to accomplish. These examples show how media, campaigns, web, and systems can take shape in different contexts. They are Industry examples, not a limit on who Rushes can help.</p>
      <a href="/industries/">Explore the industry examples <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="v3-range">
    {audiences.map((audience, index) => (
      <a
        class:list={['v3-range-card', index === 0 && 'lead']}
        href={audience.href}
        data-visual-truth={audience.visual.truthClass}
      >
        <figure>
          <HomePicture
            asset={audience.visual}
            sizes={index === 0 ? '(max-width: 760px) 100vw, 48vw' : '(max-width: 760px) 50vw, 24vw'}
          />
        </figure>
        <span class="who-card-route">{audience.routeLabel}</span>
        <h3>{audience.label}</h3>
        <p>{audience.summary}</p>
      </a>
    ))}
  </div>
</section>
