---
/**
 * A Rushes website design shown in a browser or phone frame. Frames are captured from the
 * review-only /work/ routes (review strips hidden); those routes stay out of the release build,
 * so the frames are images, never links. Files are listed in scripts/site-contract.mjs.
 */
import type { WebDesignId } from '../../data/capability-pages';

interface Props {
  design: WebDesignId;
  kind: 'desktop' | 'phone';
  name: string;
  className?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
}

const { design, kind, name, className = '', loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
const base = `/assets/images/web/${design}-${kind}`;
const widths = kind === 'desktop' ? [800, 1200, 1600] : [360, 720];
const fallback = kind === 'desktop' ? 1200 : 720;
const [width, height] = kind === 'desktop' ? [1600, 960] : [720, 1280];
const sizes = Astro.props.sizes ?? (kind === 'desktop' ? '(max-width: 760px) calc(100vw - 40px), 44vw' : '(max-width: 760px) 40vw, 180px');
const srcset = (type: string) => widths.map((w) => `${base}-${w}.${type} ${w}w`).join(', ');
const descriptions: Record<WebDesignId, string> = {
  stonevale: 'a stone patio and outdoor kitchen at dusk under the headline “Your backyard, built for the long evenings.”',
  halewood: 'a sunlit living room with leather armchairs under the headline “Rooms that hold their light.”',
};
const alt = `${name} website design on a ${kind === 'desktop' ? 'desktop screen' : 'phone'}: ${descriptions[design]}`;
---

<figure class:list={['design-frame', `design-frame--${kind}`, className]}>
  {kind === 'desktop' && <div class="design-frame__bar" aria-hidden="true"><i></i><i></i><i></i><span>{name}</span></div>}
  <picture>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <img
      src={`${base}-${fallback}.webp`}
      srcset={srcset('webp')}
      sizes={sizes}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
    />
  </picture>
</figure>
