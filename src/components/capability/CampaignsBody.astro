---
import type { CampaignsBody } from '../../data/capability-pages';
import Lead from './Lead.astro';
import Pair from './Pair.astro';

interface Props { body: CampaignsBody; }
const { body } = Astro.props;
const { matrix, plan } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section" aria-labelledby="matrix-heading">
  <Lead lead={matrix} id="matrix-heading" />
  <table id="matrix" class="cap-matrix cap-matrix--light">
    <thead>
      <tr><th scope="col">Service</th><th scope="col">What the work includes</th><th scope="col">Who decides what</th></tr>
    </thead>
    <tbody>
      {matrix.rows.map((row) => (
        <tr>
          <th scope="row"><span class="brand-media-eye">{row.label}</span><b>{row.title}</b></th>
          <td>{row.body}</td>
          <td class="cap-matrix__note">{row.note}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<section id="plan" class="cap-band cap-band--navy" aria-labelledby="plan-heading">
  <div class="cap-section">
    <Lead lead={plan} id="plan-heading" />
    <ol class="cap-flow">
      {plan.steps.map((step, index) => (
        <li>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.name}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<Pair pair={body.pair} />
