---
import DesignFrame from './DesignFrame.astro';
---

<div class="design-showcase">
  <DesignFrame design="halewood" kind="desktop" name="Halewood" className="design-showcase__back" sizes="(max-width: 760px) 80vw, 36vw" loading="eager" />
  <DesignFrame design="stonevale" kind="desktop" name="Stonevale" className="design-showcase__front" sizes="(max-width: 760px) 80vw, 36vw" loading="eager" fetchpriority="high" />
  <p class="design-showcase__caption">Stonevale and Halewood, two websites designed by Rushes</p>
</div>
