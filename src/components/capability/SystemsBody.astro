---
import type { SystemsBody } from '../../data/capability-pages';
import ConceptPicture from '../brand-media/ConceptPicture.astro';
import Lead from './Lead.astro';
import ResearchCard from './ResearchCard.astro';

interface Props { body: SystemsBody; }
const { body } = Astro.props;
const { work, example } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section cap-work" aria-labelledby="work-heading">
  <Lead lead={work} id="work-heading" />
  <div class="cap-work__grid">
    <ol id="systems-work" class="cap-work__list">
      {work.items.map((item, index) => (
        <li>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="cap-work__aside">
      <div class="cap-work__visuals">
        <ConceptPicture asset={work.visual} className="cap-work__main" sizes={work.visual.sizes} showCaption={false} />
        <ConceptPicture asset={work.inset} className="cap-work__inset" sizes="(max-width: 760px) 36vw, 180px" showCaption={false} />
      </div>
      <ResearchCard finding={work.research} className="cap-work__research" />
    </div>
  </div>
</section>

<section id="request-timeline" class="cap-band cap-band--navy" aria-labelledby="example-heading">
  <div class="cap-section">
    <Lead lead={example} id="example-heading" wide />
    <div class="cap-example-grid">
    <ol class="cap-timeline" aria-label={example.label}>
      {example.moments.map((moment) => (
        <li>
          <time>{moment.time}</time>
          <div>
            <span class="brand-media-eye">{moment.stage}</span>
            <h3>{moment.heading}</h3>
            <p>{moment.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <ResearchCard finding={example.research} className="research-card--dark" />
    </div>
  </div>
</section>
