---
import type { WebBody } from '../../data/capability-pages';
import Lead from './Lead.astro';

interface Props { body: WebBody; }
const { body } = Astro.props;
const { scope, capabilities, process } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section" aria-labelledby="scope-heading">
  <Lead lead={scope} id="scope-heading" stacked />
  <div id="scope" class="cap-options">
    {scope.options.map((option) => (
      <article>
        <h3>{option.title}</h3>
        <p>{option.body}</p>
      </article>
    ))}
  </div>
</section>

<section id="capabilities" class="cap-band cap-band--navy" aria-labelledby="capabilities-heading">
  <div class="cap-section">
    <Lead lead={capabilities} id="capabilities-heading" />
    <div class="cap-jobs">
      {capabilities.groups.map((group, index) => (
        <article>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{group.title}</h3>
          <p>{group.body}</p>
          <p class="cap-jobs__covers">{group.covers}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="process" class="cap-section" aria-labelledby="process-heading">
  <Lead lead={process} id="process-heading" />
  <ol class="cap-flow">
    {process.steps.map((step, index) => (
      <li>
        <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
        <h3>{step.name}</h3>
        <p>{step.body}</p>
      </li>
    ))}
  </ol>
</section>
