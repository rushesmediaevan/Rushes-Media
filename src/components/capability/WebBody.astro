---
import type { WebBody } from '../../data/capability-pages';
import Lead from './Lead.astro';
import Pair from './Pair.astro';

interface Props { body: WebBody; }
const { body } = Astro.props;
const { scope, example, process } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section" aria-labelledby="scope-heading">
  <Lead lead={scope} id="scope-heading" />
  <div id="scope" class="cap-options">
    {scope.options.map((option) => (
      <article>
        <h3>{option.title}</h3>
        <p>{option.body}</p>
      </article>
    ))}
  </div>
  <div class="cap-includes">
    <h3>{scope.includes.title}</h3>
    <ul>{scope.includes.items.map((item) => <li>{item}</li>)}</ul>
  </div>
</section>

<section id="website-example" tabindex="-1" class="cap-band cap-band--navy" aria-labelledby="website-example-heading">
  <div class="cap-section cap-example">
    <div>
      <span class="brand-media-eye">{example.eye}</span>
      <h2 id="website-example-heading">{example.heading}</h2>
    </div>
    <div>
      <p>{example.intro}</p>
      <p class="cap-example__note">{example.note}</p>
      <ul class="cap-example__links" aria-label="Pages to explore">
        {example.links.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </div>
</section>

<section id="process" class="cap-section" aria-labelledby="process-heading">
  <Lead lead={process} id="process-heading" />
  <ol class="cap-flow">
    {process.steps.map((step, index) => (
      <li>
        <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
        <h3>{step.name}</h3>
        <p>{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<Pair pair={body.pair} />
