---
import type { WebBody } from '../../data/capability-pages';
import ConceptPicture from '../brand-media/ConceptPicture.astro';
import Lead from './Lead.astro';
import Pair from './Pair.astro';

interface Props { body: WebBody; }
const { body } = Astro.props;
const { ladder, pains, process } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section cap-ladder-section" aria-labelledby="ladder-heading">
  <Lead lead={ladder} id="ladder-heading" />
  <ol id="decision-ladder" class="cap-ladder">
    {ladder.rungs.map((rung) => (
      <li>
        <span class="brand-media-eye">{rung.label}</span>
        <h3>{rung.title}</h3>
        <p>{rung.body}</p>
      </li>
    ))}
  </ol>
</section>

<section id="pains" class="cap-band cap-band--navy" aria-labelledby="pains-heading">
  <div class="cap-section">
    <Lead lead={pains} id="pains-heading" wide />
    <div class="cap-pains">
      {pains.items.map((pain, index) => (
        <article>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{pain.title}</h3>
          <p>{pain.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="process" class="cap-section cap-process" aria-labelledby="process-heading">
  <Lead lead={process} id="process-heading" />
  <div class="cap-process__grid">
    <ConceptPicture asset={process.asset} className="cap-process__visual" sizes={process.asset.sizes} showCaption={false} />
    <ol class="cap-steps">
      {process.steps.map((step, index) => (
        <li>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="website-example" tabindex="-1" class="cap-section" aria-labelledby="website-example-heading">
  <Lead lead={{ eye: 'Rushes Media · our own website', heading: 'Three choices behind this website.', intro: 'We built this site to help business owners understand what Rushes offers, choose the help they need and start a conversation. Here are three decisions you can inspect for yourself.' }} id="website-example-heading" />
  <ol class="cap-steps">
    <li><span class="cap-num">01</span><div><h3>Make the service clear before the sales call.</h3><p>The campaigns page separates ad management, creative, landing pages and reporting. It explains what the work includes and what the client is responsible for, so visitors can judge the fit before contacting us.</p><p><a class="brand-media-text-link" href="/campaigns/#matrix">Explore the campaign services →</a></p></div></li>
    <li><span class="cap-num">02</span><div><h3>Help visitors choose the right project.</h3><p>A landing page and a full website solve different problems. Our planning guide explains when each makes sense, while this page includes improvements to an existing site as another option.</p><p><a class="brand-media-text-link" href="/articles/landing-page-or-full-website/">Compare a landing page with a full website →</a></p></div></li>
    <li><span class="cap-num">03</span><div><h3>Keep more than one way to get in touch.</h3><p>The booking section includes an embedded calendar, a direct calendar link and an email option. Visitors can choose a contact route even when the embedded calendar does not load.</p><p><a class="brand-media-text-link" href="#book" data-link-location="website-example">Explore the contact options →</a></p></div></li>
  </ol>
  <p>This is Rushes’ own website, not an external client case study. It demonstrates our implementation, not a client’s traffic, inquiry or revenue results. Concept imagery is identified separately from completed client work.</p>
</section>

<Pair pair={body.pair} />

<style>
  #website-example .brand-media-text-link { color: var(--bm-navy); }
  #website-example .brand-media-text-link:hover { text-decoration: underline; }
  #website-example .cap-steps p + p { margin-top: 0.75rem; }
</style>
