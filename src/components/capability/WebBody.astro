---
import type { WebBody } from '../../data/capability-pages';
import ConceptPicture from '../brand-media/ConceptPicture.astro';
import Lead from './Lead.astro';
import Pair from './Pair.astro';

interface Props { body: WebBody; }
const { body } = Astro.props;
const { ladder, pains, process } = body;
---

<section id="what-this-is" tabindex="-1" class="cap-section cap-ladder-section" aria-labelledby="ladder-heading">
  <Lead lead={ladder} id="ladder-heading" />
  <ol id="decision-ladder" class="cap-ladder">
    {ladder.rungs.map((rung) => (
      <li>
        <span class="brand-media-eye">{rung.label}</span>
        <h3>{rung.title}</h3>
        <p>{rung.body}</p>
      </li>
    ))}
  </ol>
</section>

<section id="pains" class="cap-band cap-band--navy" aria-labelledby="pains-heading">
  <div class="cap-section">
    <Lead lead={pains} id="pains-heading" wide />
    <div class="cap-pains">
      {pains.items.map((pain, index) => (
        <article>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{pain.title}</h3>
          <p>{pain.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="process" class="cap-section cap-process" aria-labelledby="process-heading">
  <Lead lead={process} id="process-heading" />
  <div class="cap-process__grid">
    <ConceptPicture asset={process.asset} className="cap-process__visual" sizes={process.asset.sizes} showCaption={false} />
    <ol class="cap-steps">
      {process.steps.map((step, index) => (
        <li>
          <span class="cap-num">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="website-example" tabindex="-1" class="cap-section" aria-labelledby="website-example-heading">
  <Lead lead={{ eye: 'Rushes Media · our own website', heading: 'Explore the site you’re using.', intro: 'This is an internal Rushes project, not an external client case study. You can inspect the published pages, supporting guides and contact options directly.' }} id="website-example-heading" />
  <ol class="cap-steps">
    <li><span class="cap-num">01</span><div><h3>A home for the business.</h3><p>The homepage introduces Rushes and connects visitors to individual services. <a class="brand-media-text-link" href="/">Explore the homepage →</a></p></div></li>
    <li><span class="cap-num">02</span><div><h3>Pages that explain a specific service.</h3><p>Separate service pages give visitors room to understand the work, how to engage us and what to bring to a conversation. <a class="brand-media-text-link" href="/campaigns/">See the campaigns page →</a></p></div></li>
    <li><span class="cap-num">03</span><div><h3>Useful information and a way to contact us.</h3><p>Buyer guides help visitors prepare a project. The booking section offers a calendar and an email alternative. <a class="brand-media-text-link" href="/articles/landing-page-or-full-website/">Read the website planning guide →</a></p></div></li>
  </ol>
  <p>The published site demonstrates our own implementation. It is not evidence of a client’s traffic, lead or revenue results. Concept imagery is identified separately from completed client work.</p>
</section>

<Pair pair={body.pair} />

<style>
  #website-example .brand-media-text-link { color: var(--bm-navy); }
  #website-example .brand-media-text-link:hover { text-decoration: underline; }
</style>
