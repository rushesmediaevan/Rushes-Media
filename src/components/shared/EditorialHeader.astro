---
import { SHARED_CTA } from '../../data/site';
import { Image } from 'astro:assets';
import logoIcon from '../../../assets/images/logo-icon.png';
import logoWordmark from '../../../assets/images/logo-wordmark.png';
import { navCurrent, sitePrimaryNav, mobileNavLinks } from '../../data/navigation';
import MobileNavDialog from './MobileNavDialog.astro';

interface Props { current?: string; }
const { current = '' } = Astro.props;
---

<nav class="editorial-nav" aria-label="Primary navigation">
  <a href="/" class="editorial-logo" aria-label="Rushes Media — home">
    <Image src={logoIcon} alt="" height={44} densities={[1, 2, 3]} format="webp" quality="max" loading="eager" />
    <Image src={logoWordmark} alt="Rushes Media" height={25} densities={[1, 2, 3]} format="webp" quality="max" loading="eager" />
  </a>
  <div class="editorial-nav-links">
    {sitePrimaryNav.map((link) => (
      <a href={link.href} aria-current={navCurrent(current, link.key)}>{link.label}</a>
    ))}
    <a href="#book" class="editorial-nav-cta" data-growth-call-click data-link-location="navigation">
      {SHARED_CTA.label}
    </a>
  </div>
  <MobileNavDialog id="editorial-mobile-navigation" links={mobileNavLinks(current)} />
</nav>
