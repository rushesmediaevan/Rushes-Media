---
import type { PageSeo } from '../../data/site';
import { SITE } from '../../data/site';
import LegalLayout from '../../layouts/LegalLayout.astro';

const seo: PageSeo = {
  title: 'Terms of Service & SMS Program — Rushes Media',
  description:
    'Terms of Service and SMS messaging program terms for Rushes Group LLC (DBA Rushes Media).',
  canonical: `${SITE.origin}/terms/`,
};
---

<LegalLayout seo={seo}>

<main id="main-content" tabindex="-1">
  <h1>Terms of Service</h1>
  <p class="eff">Effective June 26, 2026 · Rushes Group LLC (DBA Rushes Media) · Haddon Heights, NJ</p>

  <div class="urls">
    <strong>Terms of Service URL:</strong> <a href="https://rushesmedia.com/terms/">https://rushesmedia.com/terms/</a><br>
    <strong>Privacy Policy URL:</strong> <a href="https://rushesmedia.com/privacy/">https://rushesmedia.com/privacy/</a><br>
    <strong>SMS opt-in (booking form):</strong> <a href="https://rushesmedia.com/#book">https://rushesmedia.com/#book</a>
  </div>

  <h2>Agreement</h2>
  <p>By accessing <a href="https://rushesmedia.com/">rushesmedia.com</a>, booking a call, or engaging our services, you agree to these Terms of Service and our <a href="https://rushesmedia.com/privacy/">Privacy Policy</a>. If you do not agree, do not use our site or services.</p>

  <h2>Services</h2>
  <p>Rushes Media provides media, content, demand generation, websites, and follow-up systems for owner-operated businesses. Specific scope, deliverables, and fees are defined in a separate signed agreement between you and Rushes Group LLC — not by this page alone.</p>
  <p>We do not guarantee specific lead volume, revenue, show rates, close rates, or closed jobs. Results depend on many factors outside our control, including your sales process and market conditions.</p>

  <h2>Acceptable use</h2>
  <ul>
    <li>You will provide accurate information when booking or contacting us.</li>
    <li>You will not misuse our site, attempt unauthorized access, or interfere with our systems.</li>
    <li>You will not use our services for unlawful purposes.</li>
  </ul>

