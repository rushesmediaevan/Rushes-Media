---
import IndustryBooking from '../../components/industry/IndustryBooking.astro';
import IndustryBreadcrumbs from '../../components/industry/IndustryBreadcrumbs.astro';
import IndustryFooter from '../../components/industry/IndustryFooter.astro';
import IndustryHeader from '../../components/industry/IndustryHeader.astro';
import {
  industriesHub,
  industriesHubSeo,
  industryPages,
} from '../../data/industry-pages';
import { HOME_FONT_URL } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const seo = industriesHubSeo();
---

<BaseLayout seo={seo} fontUrl={HOME_FONT_URL} includeMetaPixel>
  <link slot="head" rel="stylesheet" href="/assets/industry-page.css" />

  <IndustryHeader current="page" />
  <main id="main-content" tabindex="-1" data-page-family={industriesHub.family}>
    <header class="industry-hero industry-hub-hero">
      <div class="industry-hero-copy">
        <IndustryBreadcrumbs current="Industries" includeIndustries={false} />
        <span class="industry-eye">{industriesHub.eyebrow}</span>
        <h1>{industriesHub.heading}<br /><em>{industriesHub.emphasis}</em></h1>
        <p class="industry-lede">{industriesHub.lede}</p>
        <div class="industry-actions">
          <a href="#book" class="industry-button industry-button-primary" data-growth-call-click data-link-location="hero">
            {industriesHub.primaryCta} <span aria-hidden="true">→</span>
          </a>
          <a href="#markets" class="industry-button industry-button-secondary">{industriesHub.secondaryCta}</a>
        </div>
      </div>
      <aside class="industry-hero-map industry-hub-map" aria-label="Four industry examples">
        <div class="industry-hero-map-head">
          <span>Four industry examples</span>
          <small>One adaptable approach</small>
        </div>
        <ol>
          {industryPages.map((page, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{page.eyebrow}</strong></li>
          ))}
        </ol>
        <p>Each business has a different customer journey. The right work depends on the goal.</p>
      </aside>
    </header>

    <section id="markets" tabindex="-1" class="industry-section industry-markets" aria-labelledby="market-heading">
      <div class="industry-section-head">
        <span class="industry-eye">Four examples</span>
        <h2 id="market-heading">See how the approach changes by business.</h2>
        <p>Each page shows one way Rushes can adapt creative, demand, digital experience, and systems to a different customer journey.</p>
      </div>
      <div class="industry-market-pages industry-market-pages-hub">
        {industryPages.map((page) => {
          const asset = page.heroAsset;
          return (
            <a class="industry-market-card" href={page.route} data-visual-truth={asset.truthClass}>
              <picture>
                {asset.sources.map((source) => (
                  <source srcset={source.srcset} sizes="(max-width: 760px) calc(100vw - 40px), 42vw" type={source.type} media={source.media} />
                ))}
                <img
                  src={asset.fallback.src}
                  srcset={asset.fallback.srcset}
                  sizes="(max-width: 760px) calc(100vw - 40px), 42vw"
                  width={asset.fallback.width}
                  height={asset.fallback.height}
                  alt={asset.alt}
                  loading="lazy"
                  decoding="async"
                  style={`--industry-visual-position:${asset.focalPoint}`}
                />
              </picture>
              <span>{page.eyebrow}</span>
              <strong>{page.heading} <em>{page.emphasis}</em></strong>
              <small>{asset.caption}</small>
              <b>Explore the example <span aria-hidden="true">→</span></b>
            </a>
          );
        })}
      </div>
    </section>

    <section class="industry-section industry-hub-loop" aria-labelledby="shared-path-heading">
      <div class="industry-section-head">
        <span class="industry-eye">One connected system</span>
        <h2 id="shared-path-heading">The Demand Loop changes with the business.</h2>
        <p>Each capability can stand alone. When the goal spans more than one stage, Rushes connects the work from attention to action and reduces friction behind the scenes.</p>
      </div>
      <a class="industry-button industry-button-secondary" href="/demand-loop/">Explore the Demand Loop <span aria-hidden="true">→</span></a>
    </section>

    <section class="industry-section industry-faq" aria-labelledby="hub-faq-heading">
      <div class="industry-section-head">
        <span class="industry-eye">Questions owners ask</span>
        <h2 id="hub-faq-heading">Before choosing a path.</h2>
      </div>
      <div class="industry-faq-list">
        {industriesHub.faqs.map((faq) => (
          <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>
        ))}
      </div>
    </section>

    <IndustryBooking route="/industries/" close={industriesHub.bookingClose} />
  </main>
  <IndustryFooter />
</BaseLayout>
