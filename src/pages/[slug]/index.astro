---
import { capabilityPages, type CapabilityPage } from '../../data/capability-pages';
import type { IndustryPage } from '../../data/industry-pages';
import { industryPages } from '../../data/industry-pages';
import IndustryPageLayout from '../../layouts/IndustryPageLayout.astro';
import CapabilityLayout from '../../layouts/CapabilityLayout.astro';

export function getStaticPaths() {
  return [...capabilityPages, ...industryPages].map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: CapabilityPage | IndustryPage;
}

const { page } = Astro.props;
---

{page.family === 'industry'
  ? <IndustryPageLayout page={page} />
  : <CapabilityLayout page={page} />}
