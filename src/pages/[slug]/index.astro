---
import type { InnerPage } from '../../data/inner-pages';
import { innerPages } from '../../data/inner-pages';
import type { IndustryPage } from '../../data/industry-pages';
import { industryPages } from '../../data/industry-pages';
import IndustryPageLayout from '../../layouts/IndustryPageLayout.astro';
import InnerPageLayout from '../../layouts/InnerPageLayout.astro';

export function getStaticPaths() {
  return [...innerPages, ...industryPages].map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: InnerPage | IndustryPage;
}

const { page } = Astro.props;
---

{page.family === 'industry'
  ? <IndustryPageLayout page={page} />
  : <InnerPageLayout page={page} />}
