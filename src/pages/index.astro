---
import AudienceSelector from '../components/home/AudienceSelector.astro';
import BookingSection from '../components/home/BookingSection.astro';
import CustomCursor from '../components/home/CustomCursor.astro';
import FaqSection from '../components/home/FaqSection.astro';
import FloatingCta from '../components/home/FloatingCta.astro';
import HeroSection from '../components/home/HeroSection.astro';
import HomepageFooter from '../components/home/HomepageFooter.astro';
import HomepageHeader from '../components/home/HomepageHeader.astro';
import MarqueeStrip from '../components/home/MarqueeStrip.astro';
import ProblemSection from '../components/home/ProblemSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import ProofSection from '../components/home/ProofSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import SystemSection from '../components/home/SystemSection.astro';
import { faqs } from '../data/home';
import { faqPageSchema, HOME_FONT_URL, homepageSeo, SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const { '@context': _jsonLdContext, ...homepageSchema } = homepageSeo.jsonLd ?? {};
const seo = {
  ...homepageSeo,
  jsonLd: {
    '@context': 'https://schema.org',
    '@graph': [homepageSchema, faqPageSchema(faqs)],
  },
};
---

<BaseLayout
  seo={seo}
  fontUrl={HOME_FONT_URL}
  faviconHref="assets/images/logo-icon.png"
  appleTouchIconHref="assets/images/logo-icon.png"
  preloadImage={SITE.heroVideoPosterUrl}
  trackingId={SITE.ghlTrackingId}
  includeMetaPixel
>
  <CustomCursor />
  <FloatingCta />
  <HomepageHeader />
  <main id="main-content" tabindex="-1">
    <HeroSection />
    <MarqueeStrip />
    <ProblemSection />
    <ServicesSection />
    <SystemSection />
    <AudienceSelector />
    <ProofSection />
    <ProcessSection />
    <FaqSection />
    <BookingSection />
  </main>
  <HomepageFooter />

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
