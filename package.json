{
  "name": "rushes-media-site",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prepare:astro-public": "node scripts/prepare-astro-public.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "RUSHES_INCLUDE_REVIEW_ROUTES=0 npm run prepare:astro-public",
    "build": "RUSHES_INCLUDE_REVIEW_ROUTES=0 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "prebuild:review": "RUSHES_INCLUDE_REVIEW_ROUTES=1 npm run prepare:astro-public",
    "build:review": "RUSHES_INCLUDE_REVIEW_ROUTES=1 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:unit": "node --test lib/*.test.*",
    "test:contract": "node scripts/assert-built-contract.mjs",
    "test:smoke:built": "node scripts/smoke-built-site.mjs",
    "test:smoke:dev": "node scripts/smoke-dev.mjs",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:contract && npm run test:smoke:built && npm run test:smoke:dev",
    "start": "node server.js",
    "start:built": "npm run build && node server.js"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.7",
    "typescript": "^6.0.3"
  }
}
